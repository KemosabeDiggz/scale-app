{
  "name": "Run Self-Repair",
  "description": "When a Run flips to failed, automatically re-executes the failed step(s) up to 2 times",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Run",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"failed\" and .trigger.old_data.status != \"failed\" and (.trigger.data.repair_attempts // 0) < 2 }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "run_self_repair",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "repair": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repairRun",
            "args": {
              "run_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Repair failed run",
            "description": "Re-run failed steps"
          }
        }
      }
    ]
  }
}